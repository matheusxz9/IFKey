PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ifkey_db

#SUAP (credenciais do app OAuth registrado no SUAP)
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=
SUAP_REDIRECT_URI=

# Mock de autenticação (desenvolvimento) — o login simula o SUAP.
# Coloque AUTH_MOCK=false quando as credenciais reais forem configuradas.
AUTH_MOCK=true
AUTH_MOCK_LOGIN=matheus

#JWT
JWT_SECRET=