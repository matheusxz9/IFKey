# Porta da API
PORT=3000

# Banco de dados (bate com o docker-compose.yml — não precisa mudar para rodar local)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ifkey_db

# SUAP (app OAuth registrado no SUAP) — peça as credenciais ao time.
# Sem isso o login via SUAP não funciona (o resto da API funciona normalmente).
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=
SUAP_REDIRECT_URI=http://localhost:5173/login/suap/callback

# Segredo dos tokens JWT. Pode deixar esse valor em desenvolvimento.
JWT_SECRET=dev-secret-mude-em-producao
